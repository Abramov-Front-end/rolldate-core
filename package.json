{
  "name": "@rolldate/core",
  "publishConfig": {
    "access": "public"
  },
  "version": "1.2.0",
  "description": "RollDate — scrolling date picker with range/multi select, highlighted dates, time picker, and main/dark/light themes",
  "main": "dist/js/rolldate.min.js",
  "types": "dist/js/rolldate.d.ts",
  "style": "dist/css/rolldate.min.css",
  "unpkg": "dist/js/rolldate.min.js",
  "jsdelivr": "dist/js/rolldate.min.js",
  "exports": {
    ".": {
      "types": "./dist/js/rolldate.d.ts",
      "import": "./dist/js/rolldate.js",
      "require": "./dist/js/rolldate.js",
      "default": "./dist/js/rolldate.js"
    },
    "./min": "./dist/js/rolldate.min.js",
    "./css": "./dist/css/rolldate.css",
    "./css/min": "./dist/css/rolldate.min.css",
    "./styles": "./dist/css/rolldate.min.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "types",
    "assets",
    "scripts/postinstall.mjs",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "bugs": {
    "url": "https://github.com/Abramov-Front-end/rolldate-core/issues",
    "email": "rolldate.support@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abramov-Front-end/rolldate-core.git"
  },
  "homepage": "https://rolldate.dev/",
  "keywords": [
    "date-picker",
    "datepicker",
    "calendar",
    "date",
    "javascript",
    "typescript",
    "ui-component",
    "vanilla-js",
    "frontend",
    "timepicker",
    "scroll",
    "rolldate"
  ],
  "author": "Abramov Yevhen <rolldate.support@gmail.com>",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs"
  }
}
